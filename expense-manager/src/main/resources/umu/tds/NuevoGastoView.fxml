<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane headerText="Introduce los detalles del gasto" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.NuevoGastoController">
   <content>
      <VBox spacing="15.0">
         <children>
            <GridPane hgap="10.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Importe (€):" />
                  <TextField fx:id="txtImporte" GridPane.columnIndex="1" />
                  
                  <Label text="Fecha:" GridPane.rowIndex="1" />
                  <DatePicker fx:id="dpFecha" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Categoría:" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cbCategoria" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
                  <Button mnemonicParsing="false" onAction="#handleGuardar" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Guardar Gasto" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </content>
</DialogPane>