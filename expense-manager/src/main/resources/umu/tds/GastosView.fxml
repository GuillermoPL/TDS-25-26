<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.GastosViewController">
   
   <top>
      <fx:include source="BarraMenu.fxml" />
   </top>

   <center>
      <VBox spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Mis Gastos">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #eeeeee; -fx-padding: 10; -fx-background-radius: 5;">
               <children>
                  <Label text="Desde:" />
                  <DatePicker fx:id="dpDesde" prefWidth="120.0" promptText="dd/mm/aaaa" />
                  <Label text="Hasta:" />
                  <DatePicker fx:id="dpHasta" prefWidth="120.0" promptText="dd/mm/aaaa" />
                  <Separator orientation="VERTICAL" />
                  <Label text="Categoría:" />
                  <ComboBox fx:id="cbCategoria" prefWidth="150.0" />
                  <Button mnemonicParsing="false" onAction="#handleFiltrar" style="-fx-background-color: #2196f3; -fx-text-fill: white;" text="Filtrar" />
                  <Button mnemonicParsing="false" onAction="#handleLimpiarFiltros" text="Limpiar" />
               </children>
            </HBox>

            <TableView fx:id="tablaGastos" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
                  <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
                  <TableColumn fx:id="colConcepto" prefWidth="250.0" text="Concepto/ID" />
                  <TableColumn fx:id="colImporte" prefWidth="100.0" text="Importe (€)" />
                  <TableColumn fx:id="colPagador" prefWidth="120.0" text="Pagador" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

<HBox alignment="CENTER_RIGHT" spacing="10.0">
   <children>
      <Button mnemonicParsing="false" onAction="#handleImportarGastos" 
              prefWidth="120.0" 
              style="-fx-background-color: #9c27b0; -fx-text-fill: white;" 
              text="Importar CSV" />
              
      <Button mnemonicParsing="false" onAction="#handleNuevoGasto" prefWidth="120.0" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Nuevo Gasto" />
      <Button mnemonicParsing="false" onAction="#handleEditarGasto" prefWidth="100.0" text="Editar" />
      <Button mnemonicParsing="false" onAction="#handleBorrarGasto" prefWidth="100.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Borrar" />
   </children>
</HBox>
         </children>
      </VBox>
   </center>
</BorderPane>