<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.CuentasViewController">
   <top>
      <fx:include source="BarraMenu.fxml" />
   </top>
   <center>
      <SplitPane dividerPositions="0.3">
         <items>
            <VBox spacing="10.0" style="-fx-padding: 15;">
               <children>
                  <Label text="Mis Cuentas">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <ListView fx:id="listaCuentasExistentes" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <VBox spacing="15.0" style="-fx-padding: 15;">
               <children>
                  <Label text="Gestión de Cuenta Compartida">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  
                  <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Nombre:" />
                        <TextField fx:id="txtNombreCuenta" promptText="Ej: Viaje Roma" GridPane.columnIndex="1" />
                        <Label text="Reparto:" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cbEstrategia" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>

                  <Separator />

                  <Label style="-fx-font-weight: bold;" text="Miembros y Configuración" />
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtLoginUsuario" promptText="Login del usuario..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleAniadirUsuario" text="Añadir Miembro" />
                     </children>
                  </HBox>

                  <TableView fx:id="tablaMiembros" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colUsuario" prefWidth="200.0" text="Usuario" />
                      <TableColumn fx:id="colPorcentaje" prefWidth="100.0" text="\% (Si aplica)" />
                      <TableColumn fx:id="colSaldo" prefWidth="120.0" text="Saldo Actual (€)" />
                    </columns>
                  </TableView>

                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button onAction="#handleRegistrarGastoEnCuenta" style="-fx-background-color: #2196f3; -fx-text-fill: white;" text="Registrar Gasto" />
                        <Button onAction="#handleLimpiar" text="Limpiar" />
                        <Button onAction="#handleCrearCuenta" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Crear Cuenta" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </items>
      </SplitPane>
   </center>
</BorderPane>